{
  "manifest_version": 3,
  "name": "Neil's Extension",
  "description": "Allows user to open tab to right of current tab and \"emphasize\" a string he/she is typing.",
  "version": "1.0",

  "browser_action": {
    "default_icon": "Me.png"
  },

  "commands": {
    "open-tab-to-right": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Opens new tab to the right of the current tab"
    }
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],

  "background": {
    "service_worker": "new_tab.js"
  },

  "content_scripts": [
    {
        "matches" : ["<all_urls>"],
        "js": ["capitalize.js"]
    }
  ]
}